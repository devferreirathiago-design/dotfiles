#!/bin/bash

# Define o arquivo de trava para evitar conflitos se você apertar muito rápido
LOCKFILE="/tmp/wallpaper_change.lock"

# Se o processo de troca já estiver rodando, encerra para não gerar fila
if [ -f "$LOCKFILE" ]; then
    exit 0
fi

# Cria a trava
touch "$LOCKFILE"

# Seleciona a imagem
IMG=$(find /home/ferreira/Pictures/Wallpapers -type f | shuf -n 1)

# Comando "Turbo": sem transição, sem cache, silenciado
/usr/bin/swww img "$IMG" --transition-type none --no-cache > /dev/null 2>&1

# Remove a trava imediatamente
rm -f "$LOCKFILE"
