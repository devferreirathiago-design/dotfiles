;; eww.yuck — dock estilo macOS (tema liquidglass) com ícones reais dos apps

(defwindow dock
  :monitor 0
  :geometry (geometry :x "0px"
                       :y "12px"
                       :width "1px"
                       :height "1px"
                       :anchor "bottom center")
  :stacking "foreground"
  :namespace "eww-dock"
  :exclusive true
  (dock-widget))

(defwidget dock-widget []
  (box :class "dock"
       :orientation "h"
       :space-evenly false
       :spacing 14
       :halign "center"
       :valign "center"

    (dock-icon :img "/usr/share/icons/hicolor/scalable/apps/kitty.svg" :cmd "kitty" :class "dock-terminal")
    (dock-icon :img "/usr/share/icons/hicolor/scalable/apps/firefox.svg" :cmd "floorp" :class "dock-browser")
    (dock-icon :img "/usr/share/icons/breeze/actions/32/folder-symbolic.svg" :cmd "thunar" :class "dock-files")
    (dock-icon :img "/home/ferreira/.local/share/icons/kora/apps/scalable/vscode.svg" :cmd "code" :class "dock-code")
    (box :class "dock-divider")
    (dock-icon :img "/usr/share/icons/breeze/actions/32/preferences-system-symbolic.svg" :cmd "xfce4-settings-manager" :class "dock-settings")
  ))

(defwidget dock-icon [img cmd class]
  (button :class "dock-icon ${class}"
          :onclick "${cmd} &"
          :tooltip "${cmd}"
    (image :path img
           :image-width 34
           :image-height 34)))
