{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 8,
    "margin-left": 350,
    "margin-right": 350,
    "spacing": 4,

    "modules-left": ["custom/arch", "hyprland/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "cpu", "memory", "pulseaudio", "clock", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "custom/arch": {
        "format": "",
        "on-click": "wofi --show drun",
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "cpu": { 
        "format": "CPU: {usage}%" 
    },

    "memory": { 
        "format": "RAM: {}%" 
    },

    "pulseaudio": {
        "format": "{volume}% Vol",
        "on-click": "bash ~/scripts/trocar_audio.sh",
        "on-click-right": "pavucontrol"
    },

    "clock": {
        "format": "{:%H:%M | %d/%m}"
    },

    "custom/power": {
        "format": "",
        "on-click": "hyprctl dispatch exit",
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "🎵",
            "firefox": "🦊",
            "spotify": ""
        },
        "status-icons": {
            "paused": "⏸"
        },
        "max-length": 40
    }
}
